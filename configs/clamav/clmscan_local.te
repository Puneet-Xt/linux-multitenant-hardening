
module clmscan_local 1.0;

require {
	type var_t;
	type user_home_dir_t;
	type user_tmp_t;
	type antivirus_t;
	type user_home_t;
	class file { link rename unlink write };
	class dir { add_name create remove_name rmdir write };
}

#============= antivirus_t ==============
allow antivirus_t user_home_dir_t:dir { add_name create remove_name rmdir write };
allow antivirus_t user_home_t:file { link rename unlink write };
allow antivirus_t user_tmp_t:file { link rename unlink write };
allow antivirus_t var_t:dir { add_name create remove_name rmdir write };
allow antivirus_t var_t:file { link rename unlink write };
